<?xml version='1.0' encoding='utf8'?>
<robot xmlns:ns0="http://www.ros.org/wiki/xacro" name="dvrk_instrument"><link name="adaptor_link" /><joint name="roll" type="revolute">
      <parent link="adaptor_link" />
      <child link="roll_link" />
      <axis xyz="0.0 0.0 1" />
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.4162" />
      <limit lower="-4.53786" upper="4.53786" velocity=".4" effort="1000" />
    </joint>

    <link name="roll_link">
      <visual>
        <origin rpy="-1.5707963267948966 0.0 1.5707963267948966" xyz="0.0 0.0 0.02975" />
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/roll/4670/roll_4670.obj" scale="0.1 0.1 0.1" />
        </geometry>
        <ns0:if value="${str(add_colors).lower() not in ['true', '1']}">
          <material name="roll_4670_shaft"><color rgba="0.55 0.55 0.55 1" /></material>
        </ns0:if>
        <ns0:instrument_link_color add_colors="${add_colors}" kind="roll" />
      </visual>
      <collision>
        
        <origin rpy="3.141592653589793 0.0 0.0" xyz="0.0 0.0 -0.27677977" />
        <geometry>
          <cylinder radius="0.0043725" length="0.5596247" />
        </geometry>
      </collision>
    </link>
  <joint name="wrist_pitch" type="revolute">
      <parent link="roll_link" />
      <child link="wrist_pitch_link" />
      <axis xyz="0.0 0.0 1" />
      <origin rpy="-1.5707963267948966 -1.5707963267948966 0.0" xyz="0.0 0.0 0.0" />
      <limit lower="-1.39626" upper="1.39626" velocity=".4" effort="1000" />
    </joint>

    <link name="wrist_pitch_link">
      <visual>
        <origin rpy="0.0 1.5707963267948966 1.5707963267948966" xyz="0.0295 0.0 0.0" />
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/wrist_pitch/0091/wrist_pitch_0091.obj" scale="0.1 0.1 0.1" />
        </geometry>
      <ns0:instrument_link_color add_colors="${add_colors}" kind="pitch" />
      </visual>
      <collision>
        
        <origin rpy="0.0 1.5707963267948966 1.5707963267948966" xyz="0.0042213 -0.00001255 -0.00003155" />
        <geometry><box size="0.0062955 0.0145274 0.0063857" /></geometry>
      </collision>

    </link>
  <joint name="wrist_yaw" type="revolute">
      <parent link="wrist_pitch_link" />
      <child link="wrist_yaw_link" />
      <axis xyz="0.0 0.0 1" />
      <origin rpy="-1.5707963267948966 -1.5707963267948966 0.0" xyz="0.0091 0.0 0.0" />
      <limit lower="-1.39626" upper="1.39626" velocity=".4" effort="1000" />
    </joint>

    <link name="wrist_yaw_link">
      <visual>
        <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.000236" />
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/wrist_yaw/0091/wrist_yaw_0091.obj" />
        </geometry>
      <ns0:instrument_link_color add_colors="${add_colors}" kind="yaw" />
      </visual>
      <collision>
        
        <origin rpy="0.0 0.0 0.0" xyz="0.0000005 0.0 -0.0001145" />
        <geometry><box size="0.001229 0.001230 0.005461" /></geometry>
      </collision>

    </link>
  <joint name="jaw" type="revolute">
      <parent link="wrist_yaw_link" />
      <child link="jaw_link" />
      <axis xyz="0.0 0.0 1" />
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
      <limit lower="-0.349066" upper="1.39626" velocity=".4" effort="1000" />
    </joint>

    <link name="jaw_link" />

    <joint name="jaw_1" type="revolute">
      <parent link="wrist_yaw_link" />
      <child link="jaw_1_link" />
      <axis xyz="0.0 0.0 1" />
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
      <limit lower="-1.5707" upper="1.5707" velocity=".4" effort="1000" />
      <mimic joint="jaw" multiplier="0.5" />
    </joint>

    <link name="jaw_1_link">
      <visual>
        
        <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.01305 0.0" />
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/tip/179/tip_179_1.obj" scale="0.001 0.001 0.001" />
        </geometry>
      <ns0:instrument_link_color add_colors="${add_colors}" kind="tip" />
      </visual>
    </link>

    <joint name="jaw_2" type="revolute">
      <parent link="wrist_yaw_link" />
      <child link="jaw_2_link" />
      <axis xyz="0.0 0.0 1" />
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
      <limit lower="-1.5707" upper="1.5707" velocity=".4" effort="1000" />
      <mimic joint="jaw" multiplier="-0.5" />
    </joint>

    <link name="jaw_2_link">
      <visual>
        
        <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.01305 0.0" />
        <geometry>
          <mesh filename="package://dvrk_model/meshes/instruments/tip/179/tip_179_2.obj" scale="0.001 0.001 0.001" />
        </geometry>
      <ns0:instrument_link_color add_colors="${add_colors}" kind="tip" />
      </visual>
    </link>

    <joint name="tool_tip" type="fixed">
      <parent link="wrist_yaw_link" />
      <child link="tool_tip_link" />
      <origin rpy="0.0 1.5707963267948966 1.5707963267948966" xyz="0.0 0.0155 -0.0016" />
    </joint>
    <link name="tool_tip_link" />

  </robot>